#!/bin/bash
# /usr/local/bin/start-prefect
PREFIX="${JUPYTERHUB_SERVICE_PREFIX:-/}"
PUBLIC_URL="${PREFECT_PUBLIC_URL:-http://localhost:8888}"

export PREFECT_SERVER_UI_SERVE_BASE="${PREFIX}proxy/absolute/4200"
export PREFECT_SERVER_UI_API_URL="${PREFIX}proxy/4200/api"   # or with ${PUBLIC_URL} if relative fails

echo ""
echo "  Open the Prefect dashboard here:"
echo "  ${PUBLIC_URL}${PREFIX}proxy/absolute/4200/"
echo ""
echo "  (Ignore the 127.0.0.1 links below; they only work inside the container.)"
echo ""

exec prefect server start --host 127.0.0.1 --port 4200 "$@"